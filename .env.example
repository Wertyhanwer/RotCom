# Скопировать в .env (в корне репозитория) и заполнить. Сам .env в git не попадает.

# --- внешние порты docker-compose ---
API_EXTERNAL_PORT=8000
FRONTEND_EXTERNAL_PORT=80
DB_EXTERNAL_PORT=5433
DB_TEST_EXTERNAL_PORT=5434
MONGO_EXTERNAL_PORT=27018
MONGO_TEST_EXTERNAL_PORT=27019

# --- Postgres ---
# внутри docker-compose api ходит в сервис db по порту 5432;
# при локальном запуске api вне docker: DB_HOST=localhost, DB_PORT=5433
DB_HOST=db
DB_PORT=5432
DB_NAME=rotcom
DB_USER=user
DB_PASSWORD=change-me
# логировать все SQL-запросы с параметрами (только для отладки)
DB_ECHO=false

# --- MongoDB (события чатов) ---
# локально вне docker: MONGO_HOST=localhost, MONGO_PORT=27018
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=rotcom
MONGO_USER=rotcom
MONGO_PASSWORD=change-me

# --- Redis (доставка WS-событий между процессами api) ---
# пусто — события доставляются только внутри одного процесса (достаточно для локального запуска)
REDIS_URL=redis://redis:6379/0
REDIS_TEST_EXTERNAL_PORT=6380

# --- JWT ---
# сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
